# Firebase istemci yapılandırması (ZORUNLU — hepsi VITE_ öneklidir)
# Değerler: Firebase Console > Proje ayarları > "Web uygulaması" bölümünden alınır.
# Bu dosyayı kopyalayıp `.env` yapın:  copy .env.example .env   (Windows)
#                                       cp .env.example .env     (macOS/Linux)

VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=....firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://....firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=...
VITE_FIREBASE_APP_ID=...

# Yerel test / derleme portu (Vite varsayılanı 5173)
# PORT=5173
