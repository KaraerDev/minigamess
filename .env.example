# Ortam değişkenleri (opsiyonel — oyun için zorunlu değil)
# Bu dosyayı kopyalayıp `.env` yapın:  copy .env.example .env   (Windows)
#                                       cp .env.example .env     (macOS/Linux)

# Sunucu portu (varsayılan 3000)
PORT=3000

# Veritabanı YOK: odalar sunucu belleğinde tutulur, yeniden başlatınca sıfırlanır.
# Aşağıdakiler yalnızca şablonun eski OAuth/DB kodları içindir; boş bırakılabilir.
# DATABASE_URL=
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# OWNER_OPEN_ID=
